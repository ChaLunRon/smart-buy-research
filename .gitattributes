# 行尾与文本属性规范化
# 防止 Windows / macOS / Linux 贡献者提交时把整个文件的行尾改掉，
# 造成 diff 里出现"整文件重写"的假象。
#
# 参考：https://git-scm.com/docs/gitattributes

# 默认：交给 Git 自动判断文本文件，检出时用系统默认行尾
* text=auto

# 明确声明为文本、仓库内统一存为 LF
*.md      text eol=lf
*.py      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.cff     text eol=lf
*.toml    text eol=lf
*.sh      text eol=lf
LICENSE   text eol=lf
Makefile  text eol=lf

# 下面三个文件原先只被上面的 `* text=auto` 覆盖、**没有显式 `eol`**。
# 后果：`git archive` 对它们按 `core.eol`（默认 native）转换行尾 ——
# Windows 上产出 CRLF、Linux 上产出 LF，于是**同一个 tag 会打出两个内容不同的 zip**。
# 实测症状：`git archive` 出的包与 tag 里的 blob 逐字节比对时，恰好只有这 3 个文件不同。
# 显式钉成 LF，使 Release 资产在**逐文件内容**这一层与平台无关。
# 口径提醒：**不能**据此承诺「逐字节相同」—— zip 的条目时间戳取本机时间，
# 同一 tag 在 UTC 与 GMT+8 打出的容器字节仍会不同（差条目数 × 2 处），
# 而解压后的每个文件完全一致。详见 CHANGELOG 的「5.7」一节。
.editorconfig  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# 明确声明为二进制，禁止任何转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary

# GitHub 语言统计：把本仓库识别为文档/技能项目而非纯 Python
*.md      linguist-documentation
references/*.md linguist-documentation
docs/*.md linguist-documentation

# 让 diff 在这些文件里按章节而不是整行显示
CHANGELOG.md  diff=markdown
SKILL.md      diff=markdown
