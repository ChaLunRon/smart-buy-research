root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# 中文文档里的行尾空格有时是刻意的换行标记，故不强制裁剪
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100
quote_type = double

[*.{yml,yaml,json,cff}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
